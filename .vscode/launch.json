{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "request": "launch",
        "name": "Debug NestJS",
        "runtimeArgs": ["--nolazy", "-r", "ts-node/register"],
        "program": "${workspaceFolder}/src/main.ts",
        "cwd": "${workspaceFolder}",
        "protocol": "inspector",
        "sourceMaps": true,
        "console": "integratedTerminal",
        "outFiles": ["${workspaceFolder}/dist/**/*.js"],
        "autoAttachChildProcesses": true
      },
      {
        "type": "node",
        "request": "attach",
        "name": "Attach to NestJS",
        "port": 9229,
        "restart": true,
        "protocol": "inspector"
      }
    ]
  }
  